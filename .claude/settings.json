{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce_bq_wrapper.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/comms_lint_precheck.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/flag_net_new_tables.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/log_request.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_routing.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/capture_reminder.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/comms_cap_reminder.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/oncall_triage_reminder.sh" }
        ]
      }
    ]
  }
}

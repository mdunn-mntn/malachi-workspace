# Source of environment for the scripts. Fill these once.
# Usage inside scripts: `source "$(dirname "$0")/config.env"`
export GCP_PROJECT="${GCP_PROJECT:-dw-main-silver}"   # billing / default project id (override: GCP_PROJECT=dw-main-bronze bash bq_introspect.sh integrationprod)
export BQ_REGION="region-us-central1"     # datasets + jobs live in us-central1 (scripts strip 'region-')
export DATASETS="logdata,summarydata,core,aggregates"                 # comma-separated datasets to introspect

# --- BQ wrapper / perf-loop knobs (all overridable; safe portable defaults) ---
export BQ_GB_ABORT="${BQ_GB_ABORT:-500}"        # bq_run.sh refuses a query whose dry-run estimate exceeds this many GB (unless --force)
export BQ_GB_WARN="${BQ_GB_WARN:-50}"           # bq_run.sh nudges "sample first" above this many GB
export BQ_SAMPLE_SKIP_GB="${BQ_SAMPLE_SKIP_GB:-5}"  # below this estimate, sampling is pointless — just run full
export PERF_LOG_MAX_BYTES="${PERF_LOG_MAX_BYTES:-20000000}"  # rotate knowledge/bq/bq_perf_log.jsonl past this size (gzip → perf_archive/)

# --- Warehouse profile (portability) ---
# sqlmesh: silver.* are VIEWs over versioned sqlmesh__* physical tables; the cataloger resolves
#          view→physical to recover partition/cluster/TTL. generic: skip that resolution.
export WAREHOUSE_PROFILE="${WAREHOUSE_PROFILE:-sqlmesh}"

# Auth: run `gcloud auth login` (and `gcloud auth application-default login`) once.
# Requires on PATH: bq, jq, python3

# --- Airflow log puller (airflow_pull.sh) ---
# One row per Astronomer deployment we pull task logs from. v1 = airflow-ti only; add more rows to extend.
# The API base URL is auto-resolved+cached by airflow_pull.sh via `astro deployment inspect`; the value
# below is the cache (leave blank to force re-resolve). No secret here — the bearer is read at runtime
# from the interactive `astro` CLI context (`astro login`).
export AIRFLOW_TI_DEPLOYMENT_ID="${AIRFLOW_TI_DEPLOYMENT_ID:-cmd6bd10c0gl901rfuokgryiq}"  # airflow-ti (TI team), us-central1
export AIRFLOW_TI_API_URL="${AIRFLOW_TI_API_URL:-}"   # cached base ending in /api/v2 (auto-filled on first run)
export AIRFLOW_PULL_DIR="${AIRFLOW_PULL_DIR:-on-call/airflow_logs}"  # where day-dumps land (relative to workspace root)
export AIRFLOW_POLL_INTERVAL="${AIRFLOW_POLL_INTERVAL:-30}"  # --watch poll seconds (Astro API has no rate limit; be polite)

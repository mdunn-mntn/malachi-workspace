From 8f3e9dd55782b6c28020808fec1ce387541fed08 Mon Sep 17 00:00:00 2001
From: Malachi Dunn <malachi@mountain.com>
Date: Wed, 29 Jul 2026 12:53:37 -0700
Subject: [PATCH 2/3] perf(tpa_mntn_id_export): collapse 14 broadcast
 crossJoins into one driver-side intersect

Follow-up to the INC-005 core fix; independently reviewable and revertable. The
audience filter looped 14x doing crossJoin(broadcast(collect_set)) per data
source, stacking 14 Exchanges onto the fat mntn_id result. The allowlist is one
campaign group's categories (small), so collect it to the driver once and
intersect against per-ds literal arrays in a single select. Same output schema
and same total_cats>0 filter, no extra shuffle.
---
 models/tpa_export/tpa_mntn_id_export.py | 62 ++++++++++++++++++-------
 1 file changed, 44 insertions(+), 18 deletions(-)

diff --git a/models/tpa_export/tpa_mntn_id_export.py b/models/tpa_export/tpa_mntn_id_export.py
index c6d641e..bc75699 100644
--- a/models/tpa_export/tpa_mntn_id_export.py
+++ b/models/tpa_export/tpa_mntn_id_export.py
@@ -407,28 +407,54 @@ class TpaMntnIdExport(FileStorageBaseModel):
     def _apply_audience_filter(
         self, result: DataFrame, allow: DataFrame
     ) -> DataFrame:
-        """Intersect each ds's cats with the allowlist via broadcast collect_set."""
+        """Intersect each ds's cats with the campaign-group allowlist.
+
+        The allowlist is small (one campaign group's categories), so collect it to
+        the driver once and intersect against per-ds literal arrays in a single
+        projection. The previous version did 14 sequential ``crossJoin(broadcast)``
+        (one per data source), stacking 14 Exchanges onto the fat mntn_id result and
+        deepening its lineage, which made the rebuild in INC-005 more expensive.
+        """
         logger.info("Begin '_apply_audience_filter'")
-        remaining_sizes = []
         empty_arr = F.array().cast("array<bigint>")
 
-        for ds in self.data_source_ids:
-            allow_one = allow.where(F.col("data_source_id") == F.lit(ds)).agg(
-                F.collect_set(F.col("data_source_category_id")).alias("_allowed")
+        allow_map: dict[int, list[int]] = {
+            int(row["data_source_id"]): [int(c) for c in (row["cats"] or [])]
+            for row in (
+                allow.groupBy("data_source_id")
+                .agg(F.collect_set("data_source_category_id").alias("cats"))
+                .collect()
             )
-            result = result.crossJoin(F.broadcast(allow_one))
-            result = result.withColumn(
-                f"ds_{ds}_cats",
-                F.array_intersect(
-                    coalesce(F.col(f"ds_{ds}_cats"), empty_arr),
-                    coalesce(F.col("_allowed"), empty_arr),
-                ),
-            ).drop("_allowed")
-            remaining_sizes.append(F.size(coalesce(F.col(f"ds_{ds}_cats"), empty_arr)))
-
-        total_cats = remaining_sizes[0]
-        for size_col in remaining_sizes[1:]:
-            total_cats = total_cats + size_col
+        }
+        logger.info(
+            "Audience allowlist: %s categories across %s data sources",
+            sum(len(v) for v in allow_map.values()),
+            len(allow_map),
+        )
+
+        cat_col_names = {f"ds_{ds}_cats" for ds in self.data_source_ids}
+        keep_cols = [c for c in result.columns if c not in cat_col_names]
+
+        intersected = []
+        for ds in self.data_source_ids:
+            allowed = allow_map.get(ds, [])
+            if allowed:
+                allowed_lit = F.array(*[F.lit(int(c)) for c in allowed]).cast(
+                    "array<bigint>"
+                )
+                col = F.array_intersect(
+                    coalesce(F.col(f"ds_{ds}_cats"), empty_arr), allowed_lit
+                )
+            else:
+                col = empty_arr
+            intersected.append(col.alias(f"ds_{ds}_cats"))
+
+        result = result.select(*[F.col(c) for c in keep_cols], *intersected)
+
+        total_cats = None
+        for ds in self.data_source_ids:
+            size_col = F.size(coalesce(F.col(f"ds_{ds}_cats"), empty_arr))
+            total_cats = size_col if total_cats is None else total_cats + size_col
         result = result.where(total_cats > 0)
         logger.info("End '_apply_audience_filter'")
         return result
-- 

From eca09697164f94092bea2b2c3ffebc45ef1139a0 Mon Sep 17 00:00:00 2001
From: Malachi Dunn <malachi@mountain.com>
Date: Wed, 29 Jul 2026 13:54:51 -0700
Subject: [PATCH 1/3] fix(tpa_mntn_id_export): cache result + repartition to
 stop the 3h TTL kill

The final write rebuilt the ~1.9TB mntn_id shuffle 7-9x (mntn_df never cached)
and shuffle.partitions=1000 made each partition too big for memory, so it wrote
tens of TB of overflow to disk and ran past the 3h TTL (INC-005, verified from
the try-3 Spark event log; 150 executors, 0 lost, no OOM).

- Persist the filtered mntn_df (DISK_ONLY) and materialize once before the write.
- spark.sql.shuffle.partitions 1000 -> 8000 (~240MB/partition).
- TTL 10800 -> 14400 as margin for the first prod runs.
---
 models/tpa_export/tpa_mntn_id_export.py | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/models/tpa_export/tpa_mntn_id_export.py b/models/tpa_export/tpa_mntn_id_export.py
index 29e6cce..a284a69 100644
--- a/models/tpa_export/tpa_mntn_id_export.py
+++ b/models/tpa_export/tpa_mntn_id_export.py
@@ -17,6 +17,7 @@ from typing import Optional
 from urllib.parse import urlparse
 
 from google.cloud import storage
+from pyspark import StorageLevel
 from pyspark.errors import AnalysisException
 from pyspark.sql import DataFrame
 from pyspark.sql import SparkSession
@@ -66,8 +67,10 @@ OUTPUT_ROOT_DEV = "gs://sh-dw-external-tables-dev"
         "spark.sql.adaptive.coalescePartitions.enabled": "true",
         "spark.sql.adaptive.skewJoin.enabled": "true",
         "spark.sql.jsonGenerator.ignoreNullFields": "false",
+        # ~240MB/partition for the ~1.9TB mntn_id shuffle
+        "spark.sql.shuffle.partitions": "8000",
     },
-    timeout=10_800,
+    timeout=14_400,
     labels={
         "team": "targeting",
         "application": "tpa_export",
@@ -543,6 +546,12 @@ class TpaMntnIdExport(FileStorageBaseModel):
         mntn_df = self._mntn_id_dataframe(joined, graph_path)
         allow = self._load_audience_allowlist(int(campaign_group_id))
         mntn_df = self._apply_audience_filter(mntn_df, allow)
+
+        # Materialize once so write retries don't rebuild the upstream shuffle.
+        mntn_df = mntn_df.persist(StorageLevel.DISK_ONLY)
+        household_count = mntn_df.count()
+        logger.info("Persisted filtered mntn_id result: %s households", household_count)
+
         final_df = self._final_dataframe(mntn_df)
 
         monitor.log_execution_plan(final_df)
@@ -552,6 +561,7 @@ class TpaMntnIdExport(FileStorageBaseModel):
             "completed",
             output_path=f"{self._output_root()}/{output_prefix}",
         )
+        mntn_df.unpersist()
 
 
 if __name__ == "__main__":
-- 
